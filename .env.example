# Where `npm run dev` forwards /api requests. Point it at your QWED server.
QWED_API_URL=http://localhost:8000

# Base URL the built dashboard calls. Leave unset to call /api on the same
# origin (put the dashboard and the QWED server behind one reverse proxy).
# VITE_QWED_API_BASE=https://qwed.example.internal

# Set to true for a copy with no QWED server behind it, such as a public
# preview: the sign-in page then offers the sample data only.
# VITE_SAMPLE_ONLY=true
